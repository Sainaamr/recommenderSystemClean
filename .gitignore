# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Virtual environment
.venv/

# IDE
.idea/

# OS
.DS_Store

# Dataset — not committed (raw source data + generated historical/realtime
# splits + full_retrain's temporary combined datasets can all be large;
# regenerate via tools/split_dataset.py from raw data kept outside the repo)
dataset/

# Model checkpoints — regenerated by training, not committed,
# except the canonical reusable historical checkpoints in saved/compatible/
saved/*
!saved/compatible/

# RecBole's own training logs
log/
log_tensorboard/

# Superseded results from before the results/ directory reorg — kept locally
# for reference, not tracked going forward
results/old/

# content-init indices: large (286MB) and auto-regenerated from the checkpoint
saved/compatible/*.pkl
